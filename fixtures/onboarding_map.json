     "v": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Mapa de exemplo</title>\n<style>\nbody { margin: 0; font: 16px/1.5 sans-serif; background: #fff; color: #222; }\n#abas { position: sticky; top: 0; display: flex; gap: 16px; padding: 8px 16px; background: #eee; border-bottom: 1px solid #ccc; }\nsection[hidden], [hidden] { display: none; }\nsection { padding: 16px; }\n.alta { height: 1400px; }\nbutton { min-height: 44px; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" aria-hidden=\"true\"><symbol id=\"i-exemplo\" viewBox=\"0 0 10 10\"><circle cx=\"5\" cy=\"5\" r=\"4\"/></symbol></svg>\n<h1 id=\"titulo-exemplo\">Mapa de exemplo</h1>\n<nav id=\"abas\"><a href=\"#caminho\" data-aba=\"caminho\">Caminho</a><a href=\"#clientes\" data-aba=\"clientes\">Clientes</a><a href=\"#metodo\" data-aba=\"metodo\">Método</a></nav>\n<main>\n<section id=\"aba-caminho\" data-aba=\"caminho\">\n<div><button type=\"button\" class=\"filtro\" id=\"f-todas\" aria-pressed=\"true\">Todas</button><button type=\"button\" class=\"filtro\" id=\"f-espera\" aria-pressed=\"false\">Espera</button></div>\n<div class=\"etapa\" data-modo=\"auto\"><button type=\"button\" class=\"et-btn\" data-id=\"um\">Etapa um</button><div id=\"det-um\" hidden>Detalhe da etapa um</div></div>\n<div class=\"etapa\" data-modo=\"espera\"><button type=\"button\" class=\"et-btn\" data-id=\"dois\">Etapa dois</button><div id=\"det-dois\" hidden>Detalhe da etapa dois</div></div>\n<a id=\"ancora\" href=\"#metodo\">Ir ao Método</a><div class=\"alta\"></div>\n</section>\n<section id=\"aba-clientes\" data-aba=\"clientes\" hidden><p>Cliente exemplo_a</p></section>\n<section id=\"aba-metodo\" data-aba=\"metodo\" hidden><a id=\"fonte\" href=\"https://exemplo.invalid/fonte\" target=\"_blank\" rel=\"noopener noreferrer\">Fonte de exemplo</a></section>\n</main>\n<script>\n(function () {\n  var ABAS = ['caminho', 'clientes', 'metodo'];\n  function aba(nome) {\n    if (ABAS.indexOf(nome) < 0) nome = 'caminho';\n    ABAS.forEach(function (a) { document.getElementById('aba-' + a).hidden = a !== nome; });\n  }\n  function abre(id) {\n    var d = document.getElementById('det-' + id);\n    if (d) d.hidden = false;\n  }\n  function rota() {\n    var h = decodeURIComponent(location.hash.replace(/^#/, ''));\n    var m = /^e-(.+)$/.exec(h);\n    if (m) { aba('caminho'); abre(m[1]); return; }\n    aba(h);\n  }\n  document.addEventListener('click', function (ev) {\n    var t = ev.target.closest('.et-btn, .filtro');\n    if (!t) return;\n    if (t.matches('.et-btn')) {\n      var d = document.getElementById('det-' + t.dataset.id);\n      d.hidden = !d.hidden;\n    } else {\n      document.querySelectorAll('.filtro').forEach(function (b) { b.setAttribute('aria-pressed', String(b === t)); });\n      document.querySelectorAll('.etapa').forEach(function (e) { e.hidden = t.id === 'f-espera' && e.dataset.modo !== 'espera'; });\n    }\n  });\n  window.addEventListener('hashchange', rota);\n  rota();\n  document.body.dataset.script = 'rodou';\n})();\n</script>\n</body>\n</html>\n"
