width: 100%; min-height: var(--fc-toque); margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; cursor: pointer }\n.cel:hover { background: var(--fc-paper) }\n.tot { height: var(--fc-toque); padding-inline: var(--fc-e-1); font-family: var(--fc-display); font-weight: 500; white-space: nowrap }\nbutton:focus-visible { outline: 3px solid var(--fc-ink); outline-offset: -3px }\n.painel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; max-height: 70vh; overflow-y: auto; padding: var(--fc-e-3) 16px calc(var(--fc-e-3) + env(safe-area-inset-bottom, 0px)); background: var(--fc-surface); border-top: 1px solid var(--fc-hair); border-radius: var(--fc-r-cartao) var(--fc-r-cartao) 0 0; box-shadow: 0 -12px 40px color-mix(in srgb, var(--fc-ink) 16%, transparent); animation: sobe var(--fc-dur) var(--fc-curva) }\n.painel:focus { outline: none }\n.painel .in { max-width: 720px; margin-inline: auto }\n.painel h2 { margin: 0 0 var(--fc-e-1); font-family: var(--fc-display); font-weight: 500; font-size: var(--fc-t-h3); line-height: var(--fc-lh-h3); overflow-wrap: anywhere }\n.painel h3 { margin: var(--fc-e-2) 0 var(--fc-e-1); color: var(--fc-ink-3); font-size: var(--fc-t-rotulo); font-weight: 600; letter-spacing: var(--fc-track-rotulo); text-transform: uppercase }\n.painel p { margin: var(--fc-e-1) 0; overflow-wrap: anywhere }\n.painel ul { margin: 0; padding: 0; list-style: none }\n.painel li { margin-top: var(--fc-e-1); overflow-wrap: anywhere }\n.painel .q { color: var(--fc-ink-3); font-size: var(--fc-t-legenda); line-height: var(--fc-lh-legenda) }\n.fechar { min-height: var(--fc-toque); margin-top: var(--fc-e-2); padding: 0 var(--fc-e-3); border: 0; border-radius: var(--fc-r-pilula); background: var(--fc-accent); color: var(--fc-on-accent); font: inherit; font-weight: 500; cursor: pointer }\n.fechar:focus-visible { outline-offset: 3px }\nfooter { color: var(--fc-ink-3); font-size: var(--fc-t-legenda); line-height: var(--fc-lh-legenda) }\ntd[data-tena