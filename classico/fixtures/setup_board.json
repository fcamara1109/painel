     "v": "<title>Setup dos clientes</title>\n<style>\nbody { margin: 0; background: var(--fc-paper); color: var(--fc-ink); font-family: var(--fc-body); font-size: var(--fc-t-corpo); line-height: var(--fc-lh-corpo); font-variant-numeric: tabular-nums }\n* { box-sizing: border-box }\n[hidden] { display: none !important }\n.wrap { max-width: 1200px; margin-inline: auto; padding-inline: 16px; padding-block: 16px var(--fc-e-5); display: flex; flex-direction: column; gap: var(--fc-e-3) }\n.topo { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--fc-e-3) var(--fc-e-4); padding: var(--fc-e-3) }\n.topo .stamp { margin-top: var(--fc-e-1) }\n.totals { display: grid; grid-template-columns: 1fr 1fr; gap: var(--fc-e-2) var(--fc-e-3); width: 100%; margin: 0; padding: 0; list-style: none }\n.totals li { display: flex; flex-direction: column }\n.totals .fc-numero { font-size: var(--fc-t-h2) }\n.ajuda { display: flex; flex-direction: column; gap: var(--fc-e-2) }\n.legenda { display: flex; flex-wrap: wrap; gap: var(--fc-e-1) var(--fc-e-3); margin: 0; padding: 0; list-style: none; color: var(--fc-ink-2); font-size: var(--fc-t-legenda); line-height: var(--fc-lh-legenda) }\n.legenda li { display: flex; align-items: center; gap: var(--fc-e-1) }\n.avisos { margin: 0; padding: 0 var(--fc-e-3); list-style: none; display: flex; flex-direction: column; gap: var(--fc-e-1); color: var(--fc-ink-2); font-size: var(--fc-t-legenda); line-height: var(--fc-lh-legenda) }\n.dica { margin: 0; color: var(--fc-ink-3); font-size: var(--fc-t-legenda); line-height: var(--fc-lh-legenda) }\n.slot { display: grid; place-items: center; flex: none; width: 26px; height: 26px }\n.f { --c: var(--fc-hair-forte); position: relative; display: block; width: 26px; height: 26px; border: 3px solid var(--c); border-radius: 50% }\n.f.st-noar { --c: var(--fc-ok); background: var(--c) }\n.f.st-noar::after { content: \"\"; position: absolute; left: 5px; top: 1px; width: 6px; height: 11px; border-right: 3px solid var(--fc-surface); border-bottom: 3px solid var(--fc-surface); transform: rotate(45deg) }\n.f.st-travado { --c: var(--fc-erro); background: var(--c); border-radius: 7px }\n.f.st-travado::after { content: \"\"; position: absolute; left: 3px; top: 7px; width: 14px; height: 3px; border-radius: 2px; background: var(--fc-surface) }\n.f.st-montagem { --c: var(--fc-atencao); background: linear-gradient(90deg, var(--c) 50%, transparent 50%) }\n.f.st-desligado { --c: var(--fc-ink-3) }\n.f.st-desligado::after { content: \"\"; position: absolute; left: -3px; top: 7px; width: 26px; height: 3px; border-radius: 2px; background: var(--c); transform: rotate(-45deg) }\n.f.st-planejado { --c: var(--fc-accent); border-style: dashed }\n.f.np { background: transparent }\n.f.np.st-montagem { background: linear-gradient(90deg, color-mix(in srgb, var(--c) 30%, var(--fc-surface)) 50%, transparent 50%) }\n.f.np.st-noar::after { border-color: var(--c) }\n.f.np.st-travado::after { background: var(--c) }\n.f.st-hist { width: 8px; height: 8px; border: 0; background: var(--fc-ink-3) }\n.f.st-nada { width: 12px; height: 3px; border: 0; border-radius: 2px; background: var(--fc-hair-forte) }\n.tabela { background: var(--fc-surface); border: 1px solid var(--fc-hair); border-radius: var(--fc-r-cartao) }\ntable { border-collapse: separate; border-spacing: 0; width: max-content; min-width: 100% }\n.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap }\nth, td { --base: color-mix(in srgb, var(--pc, var(--fc-surface)) var(--pt, 0%), var(--fb, var(--fc-surface))); padding: 0; border-bottom: 1px solid var(--fc-hair); background: var(--base); font-weight: 400; text-align: center }\ntbody:last-child tr:last-child th, tbody:last-child tr:last-child td { border-bottom: 0 }\nthead th { position: sticky; top: 0; z-index: 3; border-bottom: 1px solid var(--fc-hair-forte) }\n.cli { min-width: 68px }\n.canto, .mod, .gr { position: sticky; left: 0; z-index: 2; width: 132px; min-width: 132px; text-align: left; border-right: 1px solid var(--fc-hair) }\n.canto, .mod { --fb: var(--fc-ink); background: var(--fb); color: var(--fc-paper) }\n.canto { z-index: 4; padding: var(--fc-e-1) var(--fc-e-2); font-size: var(--fc-t-rotulo); font-weight: 600; letter-spacing: var(--fc-track-rotulo); text-transform: uppercase }\n.gr { --fb: var(--fc-ink-2); background: var(--fb); color: var(--fc-paper) }\n.gf { --fb: var(--fc-paper-2) }\n.gr, .gf { padding: var(--fc-e-1) var(--fc-e-2); font-size: var(--fc-t-rotulo); font-weight: 600; letter-spacing: var(--fc-track-rotulo); text-transform: uppercase }\n.gf { padding: 0 }\n.resumo { --fb: var(--fc-paper) }\n.am { background: color-mix(in srgb, var(--fc-atencao) 20%, var(--fc-surface)) }\n.at { background: color-mix(in srgb, var(--fc-erro) 20%, var(--fc-surface)) }\n.res { padding: var(--fc-e-1) var(--fc-e-2); font-weight: 600 }\n.nm { display: flex; flex-direction: column; justify-content: center; width: 100%; min-height: var(--fc-toque); margin: 0; padding: var(--fc-e-1) var(--fc-e-2); border: 0; border-radius: 0; background: transparent; color: inherit; font: inherit; line-height: var(--fc-lh-h3); text-align: left; overflow-wrap: anywhere; cursor: pointer }\n.nm:hover { background: var(--fc-paper) }\n.cli .nm { align-items: center; padding-inline: var(--fc-e-1); font-family: var(--fc-display); font-weight: 500; text-align: center }\n.mod .nm:hover { background: color-mix(in srgb, var(--fc-paper) 14%, var(--fc-ink)) }\n.mod .nm:focus-visible { outline-color: var(--fc-paper) }\n.tp { display: inline-flex; align-items: center; gap: 4px; margin-top: var(--fc-e-1); padding: 2px 8px 2px 6px; border: 1px solid var(--fc-hair-forte); border-radius: var(--fc-r-pilula); background: var(--fc-surface); color: var(--fc-ink-2); font-family: var(--fc-body); font-size: var(--fc-t-legenda); font-weight: 400; line-height: var(--fc-lh-legenda); white-space: nowrap }\n.tp svg { fl